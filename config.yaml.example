# Example `config.yaml` file that matches
# with the `docker-compose.yaml`
# and `.env.example`.
# The filter settings provided are intended
# for the game Collective Unconscious.

dbconnect: postgres://admin:admin@localhost/minnatropolis
listenon: 127.0.0.1:8080
guardpsk:

unconscious: true
filter:
  indexpath: index.json
  singleplayerrooms:
    - 2 # start map (disclaimers, etc)
    - 3 # real-world room
    - 7 # record player
    - 9 # save notebook
  battleanimids:
  picturenames:
    - maple-wakeupsoul
  pictureprefixes:
    - protag_
    - $protag_
